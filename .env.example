# .env.example —— 复制成 .env 填真值，.env 不提交
TEAM_ID=XXXXXXXXXX
DEVELOPER_ID_APPLICATION="Developer ID Application: Your Name (XXXXXXXXXX)"
BUNDLE_ID_PREFIX=com.example.perappproxy
APP_BUNDLE_ID=com.example.perappproxy
EXT_BUNDLE_ID=com.example.perappproxy.ProxyExtension
APP_GROUP=group.com.example.perappproxy
PROFILE_APP=Signing/App_DevID.provisionprofile
PROFILE_EXT=Signing/Ext_DevID.provisionprofile
# 留空则由 scripts/gen-signing-xcconfig.sh 用 security/plutil 从上面两个 profile 里自动解析
PROFILE_APP_UUID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
PROFILE_EXT_UUID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
# SIGN_IDENTITY=            # 留空则用 DEVELOPER_ID_APPLICATION

# scripts/archive-and-notarize.sh 用的公证凭证：二选一（选一种填、另一种整段留空/删掉）
#
# 方式 A —— Apple ID + app 专用密码：
#   NOTARY_APP_SPECIFIC_PASSWORD 去 https://appleid.apple.com 登录 ->
#   "登录与安全性" -> "App 专用密码" 生成，不是你的 Apple ID 登录密码本身。
NOTARY_APPLE_ID=你的AppleID邮箱@example.com
NOTARY_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# NOTARY_TEAM_ID=           # 留空则用上面的 TEAM_ID
#
# 方式 B —— App Store Connect API key（适合 CI/自动化）：
#   三者都在 https://appstoreconnect.apple.com/access/api -> Keys 页生成/查看，
#   Access 选 Developer 权限即可；.p8 私钥文件只在生成时能下载一次。
# NOTARY_API_KEY_PATH=Signing/AuthKey_XXXXXXXXXX.p8
# NOTARY_API_KEY_ID=XXXXXXXXXX
# NOTARY_API_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
