# .env.example —— 复制成 .env 填真值，.env 不提交
TEAM_ID=XXXXXXXXXX
DEVELOPER_ID_APPLICATION="Developer ID Application: Your Name (XXXXXXXXXX)"
BUNDLE_ID_PREFIX=com.example.perappproxy
APP_BUNDLE_ID=com.example.perappproxy
EXT_BUNDLE_ID=com.example.perappproxy.ProxyExtension
APP_GROUP=group.com.example.perappproxy
PROFILE_APP=Signing/App_DevID.provisionprofile
PROFILE_EXT=Signing/Ext_DevID.provisionprofile
# 留空则由 scripts/gen-signing-xcconfig.sh 用 security/plutil 从上面两个 profile 里自动解析
PROFILE_APP_UUID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
PROFILE_EXT_UUID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
# SIGN_IDENTITY=            # 留空则用 DEVELOPER_ID_APPLICATION
