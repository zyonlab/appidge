.env
Config/Signing.xcconfig
# 公证用的 App Store Connect API 私钥(AuthKey_*.p8)绝不进 git——同 .env 的纪律。
*.p8
.build/
.swiftpm/
DerivedData/
xcuserdata/
*.xcuserstate
.DS_Store
/build/
*.ipa
*.dSYM
.claude/
# 图标源素材:只纳管 macOS 相关子集(母图 00-source + macOS 交付 01-macos);
# web 素材(02-web-icons / 03-web-intro)+ 顶层杂项(README/preview/.DS_Store)忽略。
pigeon_icon_assets/*
!pigeon_icon_assets/00-source/
!pigeon_icon_assets/01-macos/

# 描述文件含 team-identifier 与开发者证书，绝不进 git（同 .env 纪律）——本地保留供构建
Signing/*.provisionprofile

# ── Node / pnpm / Turborepo monorepo ──────────────────────────────
node_modules/
.turbo/
.pnpm-store/
# 构建产物
apps/*/dist/
apps/*/.astro/
apps/*/.wrangler/
apps/**/coverage/
# Worker/前端本地秘密（含 mock 值）绝不进 git；只提交 *.example
apps/api/.dev.vars
apps/web/.env
apps/web/.env.*
!apps/web/.env.example
.wrangler/
# Cloudflare 本地状态 / D1 本地库
apps/api/.mf/
**/.cloudflare/

