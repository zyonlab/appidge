<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSHumanReadableCopyright</key>
	<string></string>
	<key>NSSystemExtensionUsageDescription</key>
	<string>appidge 需要一个系统扩展来按进程转发 / 拦截网络流量。</string>
	<!-- Sparkle 自动升级 · appcast feed 地址(CLAUDE.md §5.6 固定为 updates 子域直达 R2,不经 Worker)。
	     构建期由 SPARKLE_FEED_URL 注入(默认 prod,见 Config/AppConfig.xcconfig)。 -->
	<key>SUFeedURL</key>
	<string>$(SPARKLE_FEED_URL)</string>
	<!-- License facade · Worker API base URL。构建期由 LICENSE_API_BASE_URL 注入;
	     Release 默认值见 Config/AppConfig.xcconfig，本地开发可显式覆盖。 -->
	<key>LicenseAPIBaseURL</key>
	<string>$(LICENSE_API_BASE_URL)</string>
	<!-- 稳定购买入口。Release 默认指向官网定价页，由官网再跳真实 Polar Checkout;
	     构建期可用 LICENSE_CHECKOUT_URL 覆盖。 -->
	<key>LicenseCheckoutURL</key>
	<string>$(LICENSE_CHECKOUT_URL)</string>
	<!-- Sparkle EdDSA(ed25519)更新签名公钥。由 Sparkle generate_keys 生成的密钥对之公钥;
	     公钥可公开、须提交(App 靠它验签更新),私钥仅存 macOS 登录钥匙串、永不进 git
	     (见 docs/sparkle-autoupdate.md)。全环境共用同一 keypair(公钥不随 staging/prod 变)。 -->
	<key>SUPublicEDKey</key>
	<string>WT7KwlPpH0/u5fUsQP4KQEw1xJYlcNMHPtdCbeC5hE4=</string>
	<!-- 自动检查更新(用户仍可在首次弹窗里改;详细策略见 docs/sparkle-autoupdate.md)。 -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
</dict>
</plist>
