    "未在 appidge 进程中发现（终端里可能仍有，见诊断）" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not found in the appidge process. Your terminal may still have them. See Diagnostics."
