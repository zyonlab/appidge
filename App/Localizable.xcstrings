        }
      }
    },
    "默认跟随系统语言，可在此覆盖。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follows the system language by default. Override it here."
          }
        }
      }
    },
