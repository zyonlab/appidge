<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>SYSX</string>
	<key>CFBundleShortVersionString</key>
	<string>$(APPIDGE_EXT_MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(APPIDGE_EXT_BUILD_NUMBER)</string>
	<key>NetworkExtension</key>
	<dict>
		<!-- App Group UserDefaults + Darwin 通知在这套 root 系统扩展上被真机验证证实不通
		     (扩展以 root 身份跑,解析到 /var/root/...;App 以登录用户身份跑,解析到 ~/...,
		     两边互相读不到——Apple DTS 论坛确认是 macOS System Extension 的已知限制)。
		     换回 NEMachServiceName + XPC。值必须以 entitlements 里的某个 App Group 为前缀
		     (Proxifier: group=NXELXU5YLW.…,machSvc 以它开头;之前用 TeamID 前缀导致
		     network_extension 类别校验 code 9,见 git log b92b35b)——我们唯一的 App Group 是
		     group.com.appidge,前缀不能变。
		     **版本后缀**(升级黑洞名字占用的根治,2026-07-27 真机三连实锤):升级替换窗口里
		     旧扩展 job(含「等重启卸载」态)一直占着固定名字,新进程注册必然失败、只能重启电脑。
		     名字带上扩展版本号后,新旧 job 各用各的名字、根本不抢。本 plist 是名字的**唯一真相源**:
		     扩展读自己的 plist 注册(ProxyExtensionProvider.startProxy),app 读内嵌扩展的 plist
		     连接(版本化优先、legacy 兜底,见 XPCTransportConfig.connectionCandidates)。 -->
		<key>NEMachServiceName</key>
		<string>group.com.appidge.xpc.$(APPIDGE_EXT_BUILD_NUMBER)</string>
		<key>NEProviderClasses</key>
		<dict>
			<key>com.apple.networkextension.app-proxy</key>
			<string>$(PRODUCT_MODULE_NAME).ProxyExtensionProvider</string>
		</dict>
	</dict>
	<key>NSSystemExtensionUsageDescription</key>
	<string>appidge 需要一个系统扩展来按进程转发 / 拦截网络流量。</string>
</dict>
</plist>
