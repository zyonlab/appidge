<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>SYSX</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NetworkExtension</key>
	<dict>
		<!-- 刻意没有 NEMachServiceName:①我们的 app↔扩展 IPC 走 Darwin 通知 + App Group 文件,
		     不用 mach 服务;②若声明它,值必须以 entitlements 里的某个 App Group 为前缀
		     (Proxifier: group=NXELXU5YLW.…,machSvc 以它开头),之前用 TeamID 前缀不满足该规则,
		     正是 network_extension 类别校验 code 9 的一个成因。不用就不声明。 -->
		<key>NEProviderClasses</key>
		<dict>
			<key>com.apple.networkextension.app-proxy</key>
			<string>$(PRODUCT_MODULE_NAME).ProxyExtensionProvider</string>
		</dict>
	</dict>
	<key>NSSystemExtensionUsageDescription</key>
	<string>appidge 需要一个系统扩展来按进程转发 / 拦截网络流量。</string>
</dict>
</plist>
