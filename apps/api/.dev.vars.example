# apps/api/.dev.vars.example —— 复制成 .dev.vars 填值；.dev.vars 已 git-ignore，绝不提交。
# 本地/CI 自动测试默认 MOCK_MODE=true：用协议化 mock，不触真实 Creem，不需要真 key。
# 上线时用 `wrangler secret put <NAME>` 注入生产 secret，绝不写进代码或 git。
#
# ── 开关 ──────────────────────────────────────────────────
# true  = 用内置协议 mock（无网络、无真实 Creem），本地/CI 默认
# false = 打真实 Creem test/prod API（需要下面的真 key + 标识）
MOCK_MODE=true

# ── Creem license API（服务端 API key，仅 Worker secret binding 持有）──
# 头 x-api-key；test 前缀 creem_test_。绝不进客户端或前端。
CREEM_API_KEY=creem_test_PLACEHOLDER_xxxxxxxxxxxxxxxx
# test：https://test-api.creem.io ；生产：https://api.creem.io
CREEM_API_BASE=https://test-api.creem.io
# 白名单：只处理本产品的 webhook 事件（staging test product 见 wrangler.toml）
CREEM_PRODUCT_ID=prod_PLACEHOLDER_xxxxxxxx

# ── Webhook 验签（头 creem-signature = hex(HMAC-SHA256(secret, rawBody))）──
# Creem 后台（Developers → Webhooks）给的 secret，按 Dashboard 显示的字面值使用
# （whsec_ 前缀不剥离、不做 base64 解码——与 Polar 的 Standard Webhooks 不同）。
CREEM_WEBHOOK_SECRET=whsec_PLACEHOLDER_xxxxxxxxxxxxxxxx

# ── 本地脱敏用 pepper：对 license key 做 HMAC fingerprint 存 D1，不存明文 key ──
LICENSE_HMAC_PEPPER=dev_pepper_PLACEHOLDER_change_me
