{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "Appidge license facade + Creem webhook Worker (Cloudflare, TypeScript module Worker)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.node.config.ts",
    "test:workers": "vitest run --config vitest.config.ts",
    "test:contract": "vitest run --config vitest.node.config.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "smoke:creem": "node --experimental-strip-types scripts/creem-sandbox-smoke.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.9.10",
    "@cloudflare/workers-types": "4.20251001.0",
    "@types/node": "22.15.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "wrangler": "4.42.0",
    "yaml": "2.8.1"
  }
}
