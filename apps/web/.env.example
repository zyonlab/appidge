# apps/web/.env.example —— 复制成 .env 填值；.env 已 git-ignore。
# 这些是「构建期公开配置」——会进静态产物、对用户可见，因此这里【不放任何 secret】。
# 缺失时 build 必须失败（不偷偷用错误生产地址）。见 apps/web 的 env 校验。
#
# 购买：Creem Hosted Checkout Link（公开链接，非 API key）
PUBLIC_CREEM_CHECKOUT_URL=https://www.creem.io/payment/PLACEHOLDER_checkout_id
# License Worker facade base（生产 https://api.appidge.app）
PUBLIC_API_BASE_URL=https://api.appidge.app
# 下载：R2 自定义域名，直达更新产物（不经 Worker）
PUBLIC_DOWNLOAD_URL=https://updates.appidge.app
