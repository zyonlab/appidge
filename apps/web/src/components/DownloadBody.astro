---
/** 下载 —— 首页锚点 section（#download）。 */
import { POLAR_CHECKOUT_URL, DOWNLOAD_URL } from '../config/site';
import type { DownloadCopy } from '../i18n/download';

interface Props {
  t: DownloadCopy;
}

const { t } = Astro.props;
---

<section class="section band" id="download">
  <div class="container">
    <div class="sec-head">
      <p class="sec-eyebrow">{t.eyebrow}</p>
      <h2>{t.h1}</h2>
      <p class="sec-sub">{t.intro}</p>
      <div class="cta-row center" style="margin-top: 26px;">
        <a class="btn btn-primary" href={DOWNLOAD_URL} rel="noopener">{t.ctaDownload}</a>
        <a class="btn btn-secondary" href={POLAR_CHECKOUT_URL} rel="noopener">{t.ctaBuy}</a>
      </div>
      <aside class="callout" style="margin: 26px auto 0; text-align: left;">
        <h3>{t.tunNoticeTitle}</h3>
        <p>{t.tunNoticeBody}</p>
      </aside>
    </div>

    <div class="steps">
      <div class="step">
        <span class="n">{t.requirementsTitle}</span>
        <ul class="step-list">
          {t.requirements.map((r) => <li>{r}</li>)}
        </ul>
      </div>
      <div class="step">
        <span class="n">{t.installTitle}</span>
        <ol class="steps-inline">
          {t.installSteps.map((s) => <li>{s}</li>)}
        </ol>
      </div>
      <div class="step">
        <span class="n">{t.updatesTitle}</span>
        <p>{t.updatesBody}</p>
      </div>
    </div>
  </div>
</section>
