---
// 法律页草稿标记 —— 明确文本需用户最终法务审核，不冒充法律意见。见 CLAUDE.md §5.2。
// 注意：中文文案必须包含「待法务审核」（check-site.mjs 对 zh 法律页断言此标记）。
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
  updated?: string;
}
const { locale = 'zh', updated } = Astro.props;
---

<aside class="draft-notice" role="note">
  {
    locale === 'zh' ? (
      <>
        <strong>草稿 · 待法务审核：</strong>
        本页按独立开发者经营模式拟定，需由合格法律顾问按适用法律最终审定，不构成法律意见。
        {updated && <span> 最后更新：{updated}。</span>}
      </>
    ) : (
      <>
        <strong>Draft — pending legal review:</strong>
        This page is drafted for an independent solo-developer operation and is subject to
        final review by qualified counsel under applicable law. It does not constitute legal
        advice.
        {updated && <span> Last updated: {updated}.</span>}
      </>
    )
  }
</aside>
