---
import { SITE_NAME, SUPPORT_EMAIL } from '../config/site';
import { localePath, ui, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const year = new Date().getFullYear();

const productLinks = [
  { path: '/download', label: t.nav.download },
  { path: '/pricing', label: t.nav.pricing },
];
const supportLinks = [{ path: '/faq', label: t.nav.faq }];
const legalLinks = [
  { path: '/refund', label: t.nav.refund },
  { path: '/privacy', label: t.footer.privacy },
  { path: '/terms', label: t.footer.terms },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href={localePath(locale, '/')}>
          <img class="brand-mark" src="/icon-64.png" alt="" width="26" height="26" />{SITE_NAME}
        </a>
        <p class="footer-blurb">{t.footer.blurb}</p>
      </div>
      <nav aria-label={t.footer.product}>
        <h4>{t.footer.product}</h4>
        <ul>
          {productLinks.map((l) => <li><a href={localePath(locale, l.path)}>{l.label}</a></li>)}
        </ul>
      </nav>
      <nav aria-label={t.footer.support}>
        <h4>{t.footer.support}</h4>
        <ul>
          {supportLinks.map((l) => <li><a href={localePath(locale, l.path)}>{l.label}</a></li>)}
          <li><a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></li>
        </ul>
      </nav>
      <nav aria-label={t.footer.legal}>
        <h4>{t.footer.legal}</h4>
        <ul>
          {legalLinks.map((l) => <li><a href={localePath(locale, l.path)}>{l.label}</a></li>)}
        </ul>
      </nav>
    </div>
    <div class="footer-meta">
      <p>© {year} {SITE_NAME}. {t.footer.rights} · {t.footer.meta}</p>
      <p>{t.footer.trademark}</p>
    </div>
  </div>
</footer>
