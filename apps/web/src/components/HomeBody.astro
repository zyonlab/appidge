---
/**
 * 首页正文（不含 BaseLayout）——由 zh / en 两个页面以不同文案字典渲染。
 * 产品展示图为真实 Activity 截图（activity.webp，敏感目的地已打码），
 * 下载/定价/FAQ 由页面级组合的锚点 section 承载（见 pages/index.astro）。
 */
import { POLAR_CHECKOUT_URL } from '../config/site';
import { localePath, type Locale } from '../i18n';
import type { HomeCopy } from '../i18n/home';

interface Props {
  locale: Locale;
  t: HomeCopy;
}

const { locale, t } = Astro.props;
---

<!-- Hero -->
<section class="hero">
  {/* 品牌白鸽（图标抠图,透明底）：宽屏时悬浮于左侧留白,CSS 悬飞动画,纯装饰 */}
  <img
    class="hero-dove"
    src="/dove.webp"
    alt=""
    aria-hidden="true"
    width="900"
    height="874"
    loading="lazy"
  />
  <div class="container">
    <p class="hero-chip">{t.hero.chip}</p>
    <h1><span class="pain">{t.hero.h1Pain}</span><em>{t.hero.h1Em}</em></h1>
    <p class="hero-sub" set:html={t.hero.subHtml} />
    <div class="cta-row">
      <a class="btn btn-primary" href={localePath(locale, '/#download')}>{t.hero.ctaDownload}</a>
      <a class="btn btn-secondary" href={POLAR_CHECKOUT_URL} rel="noopener">{t.hero.ctaBuy}</a>
    </div>
    <p class="hero-note" set:html={t.hero.noteHtml} />
  </div>
</section>

<!-- 产品截图（真实 Activity 视图，敏感目的地已打码） -->
<div class="stage">
  <div class="container stage-inner">
    <img
      class="stage-shot"
      src="/activity.webp"
      alt={t.panel.title}
      width="994"
      height="714"
      loading="eager"
    />
    <p class="stage-caption" set:html={t.panel.captionHtml} />
  </div>
</div>

<!-- 场景 -->
<section class="section band" id="scenes">
  <div class="container">
    <div class="sec-head">
      <p class="sec-eyebrow">{t.scenes.eyebrow}</p>
      <h2>{t.scenes.h2}</h2>
      <p class="sec-sub">{t.scenes.sub}</p>
    </div>
    <div class="usecases">
      {
        t.scenes.cards.map((c) => (
          <article class="ucard">
            <h3>
              {c.title}
              {c.hot && <span class="hot">{t.scenes.hotTag}</span>}
            </h3>
            <p>{c.body}</p>
            <div class="uc-tools">
              {c.tools.map((tool) => (
                <span>{tool}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- 工作原理 -->
<section class="section" id="how">
  <div class="container">
    <div class="sec-head">
      <p class="sec-eyebrow">{t.how.eyebrow}</p>
      <h2>{t.how.h2}</h2>
      <p class="sec-sub">{t.how.sub}</p>
    </div>
    <div class="steps">
      {
        t.how.steps.map((s) => (
          <div class="step">
            <span class="n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- 方案对比 -->
<section class="section band" id="compare">
  <div class="container">
    <div class="sec-head">
      <p class="sec-eyebrow">{t.compare.eyebrow}</p>
      <h2>{t.compare.h2}</h2>
    </div>
    <div class="compare-wrap">
      <table class="compare">
        <thead>
          <tr>
            <th>{t.compare.thApproach}</th>
            <th>{t.compare.thCoverage}</th>
            <th>{t.compare.thGranularity}</th>
            <th>{t.compare.thCost}</th>
          </tr>
        </thead>
        <tbody>
          {
            t.compare.rows.map((r) => {
              const cls = r.highlight ? 'col-hl' : '';
              const mark = (m: 'yes' | 'no' | 'part') =>
                m === 'yes' ? '✓' : m === 'no' ? '✗' : '△';
              return (
                <tr>
                  <td class={cls}>{r.name}</td>
                  <td class={cls}>
                    <span class={`mark-${r.coverageMark}`}>{mark(r.coverageMark)}</span> {r.coverage}
                  </td>
                  <td class={cls}>
                    <span class={`mark-${r.granularityMark}`}>{mark(r.granularityMark)}</span>{' '}
                    {r.granularity}
                  </td>
                  <td class={cls}>{r.cost}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
    <p class="compare-note" set:html={t.compare.noteHtml} />
  </div>
</section>

<!-- 非 VPN 声明 -->
<section class="section" id="not-vpn">
  <div class="container">
    <div class="sec-head">
      <p class="sec-eyebrow">{t.notvpn.eyebrow}</p>
      <h2>{t.notvpn.h2}</h2>
      <p class="sec-sub">{t.notvpn.sub}</p>
    </div>
    <div class="notvpn-points">
      {
        t.notvpn.points.map((p) => (
          <div class="nv">
            <span class={`sign sign-${p.sign}`} aria-hidden="true">
              {p.sign === 'no' ? '✗' : '✓'}
            </span>
            <b>{p.title}</b>
            <span>{p.body}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

