---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME, SITE_TAGLINE, SITE_URL } from '../config/site';
import { HREFLANG, HTML_LANG, LOCALES, OG_LOCALE, localePath, ui, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  /** locale 无关的逻辑路径，如 "/pricing"。canonical 与 hreflang 由 locale 推导。 */
  path?: string;
  /** 页面语言。默认英文（根路径）。 */
  locale?: Locale;
  /** 页面级 JSON-LD（对象）。默认注入 WebSite。 */
  jsonld?: Record<string, unknown>;
}

const { title, description, path = '/', locale = 'en', jsonld } = Astro.props;

const t = ui[locale];
const canonical = new URL(localePath(locale, path), SITE_URL).href;
const isHome = path === '/';
// 单一真相源：定位口径只在 site.ts 定一处。此处原先硬编了一份副本，导致 SITE_TAGLINE
// 成了从未被引用的死常量——改它以为改了站点，其实没有。
const tagline = SITE_TAGLINE[locale === 'zh' ? 'zh' : 'en'];
const fullTitle = isHome ? `${SITE_NAME} · ${tagline}` : `${title} · ${SITE_NAME}`;

const defaultJsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: SITE_URL,
  description: tagline,
};
const structuredData = jsonld ?? defaultJsonld;
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="index, follow" />

    {/* 双语互指 + x-default（默认指英文，与路径策略一致） */}
    {
      LOCALES.map((l) => (
        <link
          rel="alternate"
          hreflang={HREFLANG[l]}
          href={new URL(localePath(l, path), SITE_URL).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath('en', path), SITE_URL).href}
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />

    <meta property="og:image" content={new URL('/og.png', SITE_URL).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', SITE_URL).href} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* 品牌图标（白鸽衔标）：ico 兜底 + 32px png + iOS 触摸图标。theme-color 取品牌橙。 */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FF6B2C" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <Header locale={locale} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
