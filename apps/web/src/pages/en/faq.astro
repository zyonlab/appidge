---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqBody from '../../components/FaqBody.astro';
import { faq } from '../../i18n/faq';

const t = faq.en;

const stripTags = (html: string) => html.replace(/<[^>]+>/g, '');
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: stripTags(i.aHtml) },
  })),
};
---

<BaseLayout title={t.title} description={t.metaDescription} path="/faq" locale="en" jsonld={jsonld}>
  <FaqBody t={t} />
</BaseLayout>
