---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingBody from '../components/PricingBody.astro';
import { pricing } from '../i18n/pricing';

const t = pricing.zh;
---

<BaseLayout title={t.title} description={t.metaDescription} path="/pricing" locale="zh">
  <PricingBody locale="zh" t={t} />
</BaseLayout>
