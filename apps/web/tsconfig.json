{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*.ts", "**/*.astro"],
  "exclude": ["dist"],
  "compilerOptions": {
    "strict": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@layouts/*": ["./node_modules/aifb-engine/layouts/*"],
      "@components/*": ["./node_modules/aifb-engine/components/*"]
    }
  }
}
